<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <h1><%= title %></h1>
     <%- include('navbar') %>
    <ul>
  <% messages.forEach((message) => { %>
    <li>
      <p>
      <%= message.user %>: <%= message.text %>
    </p>
    <p>
      <%= message.added.toLocaleString() %>
    </p>
      <a href="/message/<%= message.id %>">
    <span>Open</span>
  </a>
    </li>
    
  <% }); %>
</ul>
  </body>
</html>