<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <h1><%= title %></h1>
    <form method="POST" action="/new">
      <div>
        <label for="user">User:</label>
        <input
          type="text"
          id="user"
          name="user"
          placeholder="Enter user"
          required
        />
      </div>
      <div>
        <label for="message">Message:</label>
        <input
          type="text"
          id="message"
          name="message"
          placeholder="Enter message"
          required
        />
      </div>
      <button type="submit">Submit</button>
    </form>
  </body>
</html>
